{
  "tool": "todo.list",
  "description": "Lists tasks from your to-do list, optionally filtered by status and/or bucket.",
  "permission_level": 0,
  "estimated_cost": 0.0,
  "requires_network": false,
  "supports_rollback": false,
  "rollback_action": null,
  "params_schema": {
    "type": "object",
    "required": [],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "done",
          "all"
        ],
        "description": "Filter by status. Defaults to pending."
      },
      "bucket": {
        "type": "string",
        "enum": [
          "today",
          "tomorrow",
          "this_week",
          "backlog"
        ],
        "description": "Filter by a specific time bucket."
      }
    }
  },
  "read_only": true,
  "patterns": [
    {
      "regex": "(?:list|show)\\s+(?:all\\s+)?(?:my\\s+)?(?:pending|open|remaining|unfinished)\\s+(?:todos|tasks|to-dos)",
      "priority": 180,
      "params": {
        "status": "pending"
      }
    },
    {
      "regex": "what\\s+(?:are|is)\\s+(?:my|on\\s+my)\\s+(?:tasks|todos|to-dos|to-do\\s+list|todo\\s+list)\\??$",
      "priority": 190,
      "params": {
        "status": "pending"
      }
    },
    {
      "regex": "(?:list|show)\\s+done\\s+(?:todos|tasks|list)",
      "priority": 200,
      "params": {
        "status": "done"
      }
    },
    {
      "regex": "(?:list|show)\\s+all\\s+(?:todos|tasks|list)",
      "priority": 210,
      "params": {
        "status": "all"
      }
    },
    {
      "regex": "(?:list|show)\\s+(?:todos|tasks|list)",
      "priority": 220,
      "params": {
        "status": "pending"
      }
    }
  ]
}
