{
  "tool": "todo.add",
  "description": "Adds a new task to your to-do list with optional bucket and due date.",
  "permission_level": 0,
  "estimated_cost": 0.0,
  "requires_network": false,
  "supports_rollback": true,
  "rollback_action": "todo.remove",
  "params_schema": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "description": "The description of the task."
      },
      "bucket": {
        "type": "string",
        "enum": [
          "today",
          "tomorrow",
          "this_week",
          "backlog"
        ],
        "description": "The time bucket for the task. Defaults to backlog."
      },
      "due_date": {
        "type": "string",
        "description": "Optional due date or natural language date (e.g. 'Friday', 'tomorrow', '2026-07-15')."
      }
    }
  },
  "rollback_params": {
    "text": "$result.todo.id"
  },
  "patterns": [
    {
      "regex": "add\\s+a\\s+task\\s+(?:to\\s+)?(?P<text>.+)",
      "priority": 140
    },
    {
      "regex": "(?:add\\s+)?(?:todo|task)\\s+(?P<text>.+)",
      "priority": 150
    }
  ]
}
