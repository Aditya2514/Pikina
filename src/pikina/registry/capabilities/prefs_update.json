{
  "tool": "prefs.update",
  "description": "Updates a specific field in your conversational preferences profile.",
  "permission_level": 0,
  "estimated_cost": 0.0,
  "requires_network": false,
  "supports_rollback": true,
  "rollback_action": "prefs.update",
  "params_schema": {
    "type": "object",
    "required": [
      "field",
      "value"
    ],
    "properties": {
      "field": {
        "type": "string",
        "enum": [
          "preferred_name",
          "formality",
          "verbosity",
          "humor",
          "quiet_hours"
        ],
        "description": "The profile field to update."
      },
      "value": {
        "description": "The new value to assign. Can be string or array for quiet_hours."
      }
    }
  },
  "rollback_params": {
    "field": "$params.field",
    "value": "$result.previous_value"
  },
  "patterns": [
    {
      "regex": "call\\s+me\\s+(?P<value>.+)",
      "priority": 290,
      "params": {
        "field": "preferred_name"
      }
    },
    {
      "regex": "be\\s+(?P<value>casual|formal|neutral)",
      "priority": 300,
      "params": {
        "field": "formality"
      }
    },
    {
      "regex": "be\\s+(?P<value>concise|detailed|balanced)",
      "priority": 310,
      "params": {
        "field": "verbosity"
      }
    },
    {
      "regex": "quiet\\s+hours\\s+from\\s+(?P<start>\\d{2}:\\d{2})\\s+to\\s+(?P<end>\\d{2}:\\d{2})",
      "priority": 320,
      "params": {
        "field": "quiet_hours"
      }
    }
  ]
}
