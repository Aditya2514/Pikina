{
  "tool": "calendar.add_event",
  "description": "Adds an event to your calendar with optional time, type, and recurrence.",
  "permission_level": 0,
  "estimated_cost": 0.0,
  "requires_network": false,
  "supports_rollback": true,
  "rollback_action": "calendar.remove_event",
  "params_schema": {
    "type": "object",
    "required": [
      "title",
      "date"
    ],
    "properties": {
      "title": {
        "type": "string",
        "description": "The title of the event."
      },
      "date": {
        "type": "string",
        "description": "Date or natural language date expression (e.g. 'tomorrow', 'July 20th at 3pm')."
      },
      "time": {
        "type": "string",
        "description": "Optional time (e.g. '15:00', '3:00 PM')."
      },
      "type": {
        "type": "string",
        "enum": [
          "personal",
          "college",
          "appointment",
          "holiday"
        ],
        "description": "Category of the event. Defaults to personal."
      },
      "recurring": {
        "type": "string",
        "enum": [
          "none",
          "yearly"
        ],
        "description": "Recurrence pattern. Defaults to none."
      },
      "description": {
        "type": "string",
        "description": "Optional detailed description of the event."
      }
    }
  },
  "rollback_params": {
    "text": "$result.event.id"
  },
  "patterns": [
    {
      "regex": "add\\s+(?:appointment|event|meeting)\\s+(?P<title>.+?)\\s+(?:on|at|date)\\s+(?P<date>.+)",
      "priority": 240
    },
    {
      "regex": "add\\s+(?:appointment|event|meeting)\\s+(?P<title>.+)",
      "priority": 250,
      "params": {
        "date": ""
      }
    }
  ]
}
