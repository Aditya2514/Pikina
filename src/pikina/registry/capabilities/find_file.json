{
  "tool": "fs.find_file",
  "description": "Searches for files matching a name pattern within a root directory.",
  "permission_level": 0,
  "estimated_cost": 0.05,
  "requires_network": false,
  "supports_rollback": false,
  "rollback_action": null,
  "params_schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "File name or glob pattern (e.g. *.pdf or resume*). No quotes around the value."
      },
      "root": {
        "type": "string",
        "description": "Root directory to search from. Defaults to user home directory."
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum results to return. Default 20."
      }
    }
  },
  "read_only": true,
  "patterns": [
    {
      "regex": "(?:find|look\\s+up|search\\s+for|where\\s+is)\\s+(?:files?\\s+(?:with\\s+)?|file\\s+called\\s+)?(?P<name>[\\w\\s.*-]+\\.\\w+)",
      "priority": 70
    },
    {
      "regex": "(?:look\\s+up|search\\s+for)\\s+files?\\s+(?:with\\s+|named?\\s+|called\\s+)?(?P<name>[\\w\\s*.-]+?)(?:\\s+in\\s+(?:the\\s+)?name)?$",
      "priority": 80
    },
    {
      "regex": "find\\s+(?:file\\s+)?(?P<name>.+)",
      "priority": 90
    }
  ]
}
