# Pikina OS — Environment Configuration
# Copy this to .env and fill in your values.
# Never commit your actual .env file.

# OpenWeatherMap API key (free tier is sufficient)
# Get one at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# Your city for the weather widget
OPENWEATHER_CITY=Delhi

# Port the backend Flask server listens on
BACKEND_PORT=5001

# --- Tier 2 (local Ollama LLM) -------------------------------------------
# Set to 0 to run fully deterministic (Tier 1 regex only)
PIKINA_TIER2=1
PIKINA_OLLAMA_URL=http://localhost:11434
# Smaller models answer much faster on CPU, e.g. qwen2.5:3b or llama3.2:3b
PIKINA_OLLAMA_MODEL=llama3
# Seconds to wait for one answer (a cold 8B model load alone can take 10-30s)
PIKINA_OLLAMA_TIMEOUT=30
# How long Ollama keeps the model in RAM between commands
PIKINA_OLLAMA_KEEP_ALIVE=30m
# Above this many capabilities, only the most relevant are sent to the model
PIKINA_TIER2_MAX_TOOLS=25

# Skip the clipboard / file watcher / indexer / memory daemons (headless servers, tests)
# PIKINA_NO_DAEMONS=1
